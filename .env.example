# Покупательский бот Telegram
TELEGRAM_SHOP_TOKEN=123456:replace_me

# Отдельный Telegram-бот для управления товарами
TELEGRAM_ADMIN_TOKEN=123456:replace_me

# Числовые Telegram ID администраторов через запятую
ADMIN_TELEGRAM_IDS=123456789

# Бот магазина в MAX. Оставьте пустым, чтобы временно запускать только Telegram.
MAX_BOT_TOKEN=

# Для production задайте публичный HTTPS URL; без него MAX работает через polling.
# MAX принимает webhook только на внешнем HTTPS-порту 443. Прокси направляет его на WEBHOOK_PORT.
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=replace_with_random_letters_digits_dashes
WEBHOOK_PORT=8080

SHOP_NAME=Мастерская «Тёплые руки»
SHOP_CURRENCY=₽
SHOP_CONTACT=@your_username
DB_PATH=data/shop.db
PRODUCT_IMAGES_DIR=data/products
LOG_LEVEL=INFO
